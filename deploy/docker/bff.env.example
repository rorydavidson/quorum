# Quorum BFF — Docker environment template
# Copy to bff.env and fill in all CHANGE_ME values.
# Variables set in docker-compose.yml (DATABASE_URL, REDIS_URL, PORT, NODE_ENV,
# FRONTEND_ORIGIN) do NOT need to be duplicated here — compose values take precedence.

# ── Keycloak OIDC ────────────────────────────────────────────────────────────
KEYCLOAK_URL=https://CHANGE_ME
KEYCLOAK_REALM=CHANGE_ME
KEYCLOAK_CLIENT_ID=quorum
KEYCLOAK_CLIENT_SECRET=CHANGE_ME

# MUST be the public URL as seen by the browser (through nginx), NOT an internal URL.
# Must match what is registered in Keycloak as a valid redirect_uri.
KEYCLOAK_REDIRECT_URI=https://CHANGE_ME_DOMAIN/auth/callback

# ── Session ──────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=CHANGE_ME_MIN_32_CHARS
SESSION_COOKIE_NAME=quorum_session

# ── Google APIs (Service Account) ────────────────────────────────────────────
GOOGLE_SERVICE_ACCOUNT_EMAIL=CHANGE_ME@CHANGE_ME.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nCHANGE_ME\n-----END PRIVATE KEY-----\n"
GOOGLE_PROJECT_ID=CHANGE_ME

# ── Discourse ────────────────────────────────────────────────────────────────
DISCOURSE_URL=https://CHANGE_ME
# Uncomment for private/restricted categories:
# DISCOURSE_API_KEY=CHANGE_ME
# DISCOURSE_API_USERNAME=quorum-system

# ── Rate Limiting (requests per minute per IP) ──────────────────────────────
# RATE_LIMIT_GLOBAL=100
# RATE_LIMIT_AUTH=30
# RATE_LIMIT_SEARCH=20
# RATE_LIMIT_UPLOAD=10

# ── Cache TTLs (seconds) ────────────────────────────────────────────────────
# CACHE_TTL_DRIVE_LIST=60
# CACHE_TTL_DRIVE_ANCESTRY=300

# ── Database Pool ───────────────────────────────────────────────────────────
# DB_POOL_MAX=25

# ── Dev auth bypass (local testing without Keycloak) ─────────────────────────
# Uncomment to skip Keycloak entirely (uses a fake admin user):
# DEV_AUTH_BYPASS=true

# ── Email notifications (SMTP) — "Notify me" feature ────────────────────────
# Leave SMTP_HOST unset to disable email (mailer logs instead of sending).
# SMTP_HOST=CHANGE_ME
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=CHANGE_ME
# SMTP_PASS=CHANGE_ME
# SMTP_FROM=Quorum <no-reply@CHANGE_ME_DOMAIN>

# ── Rate limiting store ─────────────────────────────────────────────────────
# docker-compose provides REDIS_URL=redis://redis:6379 automatically, so you do
# NOT need to set it here. Only set it for non-compose deployments that run
# Redis elsewhere; omit entirely to fall back to the in-memory store.
# REDIS_URL=redis://CHANGE_ME:6379
