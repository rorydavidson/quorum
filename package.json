{
  "name": "quorum",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "pnpm build && concurrently \"pnpm --filter bff dev\" \"pnpm --filter web dev\"",
    "build": "pnpm --filter types build && pnpm --filter bff build && pnpm --filter web build",
    "typecheck": "pnpm --recursive typecheck",
    "lint": "pnpm --recursive lint",
    "test": "pnpm --filter bff test && pnpm --filter web test",
    "test:coverage": "pnpm --filter bff test:coverage",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "concurrently": "^9.1.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ],
    "overrides": {
      "postcss@<8.5.23": "^8.5.23",
      "sharp@<0.35.5": "^0.35.5",
      "source-map-js@<1.2.2": "^1.2.2",
      "shell-quote@<1.9.0": "^1.12.0",
      "undici@<7.29.1": "^7.29.1"
    }
  }
}
